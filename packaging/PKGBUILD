# Local Arch/CachyOS package definition for the KachyOS security workstation layer.
# Build from the repository root with: makepkg -si packaging/PKGBUILD

pkgname=kachysec
pkgver=0.1.0
pkgrel=1
pkgdesc='Modular security workstation control plane for CachyOS'
arch=('any')
url='https://github.com/UseBrainNoL0ve/KachyOS'
license=('MIT')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-setuptools')
source=()

build() {
    cd "$srcdir/.."
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/.."
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
